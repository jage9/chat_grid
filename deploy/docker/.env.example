# Copy to grid/.env and keep it private.
# Run Compose commands from the grid folder.
COMPOSE_FILE=../compose.yaml
# init.sh fills the secret and current host UID/GID for a new installation.
CHGRID_AUTH_SECRET=
# Exact public origin, without a URL path, even for a grid at /ttgrid/.
CHGRID_HOST_ORIGIN=http://localhost:8080

# Voice uses an existing LiveKit deployment. All three values are required.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional comma-separated hostnames allowed by the PHP media proxy.
# CHGRID_MEDIA_PROXY_ALLOWLIST=example.com

# Bind the web service to the host loopback port used by your HTTPS reverse proxy.
CHGRID_HTTP_PORT=8080
# Per-grid host folder containing config.toml and data/.
CHGRID_INSTANCE_DIR=./grid
# Linux owner of the data folder. init.sh fills these for the current user.
CHGRID_UID=1000
CHGRID_GID=1000
