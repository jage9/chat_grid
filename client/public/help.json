{
  "sections": [
    {
      "title": "Chat Grid Help",
      "items": [
        {
          "keys": "Arrow Keys",
          "description": "Move on the grid"
        },
        {
          "keys": "Shift+K / Applications / Shift+F10",
          "description": "Open the command palette in supported modes"
        },
        {
          "keys": "C",
          "description": "Speak your coordinates"
        },
        {
          "keys": "N",
          "description": "Change nickname"
        },
        {
          "keys": "Escape",
          "description": "Disconnect/cancel"
        }
      ]
    },
    {
      "title": "Users and Chat",
      "items": [
        {
          "keys": "L",
          "description": "Locate nearest user; includes what they are carrying, if anything"
        },
        {
          "keys": "Shift+L",
          "description": "List users, including what they are carrying; Enter teleports to that user, left/right arrow adjusts volume"
        },
        {
          "keys": "U",
          "description": "Speak connected users"
        },
        {
          "keys": "Slash",
          "description": "Start chat"
        },
        {
          "keys": "Slash commands",
          "description": "In chat, use /me <action>, /up for uptime, and /version for server version"
        },
        {
          "keys": "Comma / Period",
          "description": "Previous/next message"
        },
        {
          "keys": "Less Than / Greater Than",
          "description": "First/last message"
        }
      ]
    },
    {
      "title": "Items",
      "items": [
        {
          "keys": "H",
          "description": "Speak what you are holding, or that you are holding nothing"
        },
        {
          "keys": "I",
          "description": "Locate nearest item"
        },
        {
          "keys": "Shift+I",
          "description": "List items; Enter teleports to that item"
        },
        {
          "keys": "A",
          "description": "Add item"
        },
        {
          "keys": "O",
          "description": "Edit a held item or an item on your square; choose from a list when needed"
        },
        {
          "keys": "Shift+O",
          "description": "Inspect a held item or an item on your square; choose from a list when needed"
        },
        {
          "keys": "D",
          "description": "Choose an item to pick up or drop; held items and items on your square are listed together"
        },
        {
          "keys": "Z",
          "description": "Manage held items or items on your square (delete/transfer when permitted; drop before transferring)"
        },
        {
          "keys": "Enter",
          "description": "Use a held item or an item on your square; choose from a list when needed"
        },
        {
          "keys": "Shift+Enter",
          "description": "Secondary action for a held item or an item on your square; choose from a list when needed"
        }
      ]
    },
    {
      "title": "Audio",
      "items": [
        {
          "keys": "P",
          "description": "Ping server"
        },
        {
          "keys": "M",
          "description": "Mute/unmute yourself"
        },
        {
          "keys": "Shift+M",
          "description": "Toggle stereo/mono output"
        },
        {
          "keys": "! (Shift+1)",
          "description": "Toggle loopback monitor"
        },
        {
          "keys": "1",
          "description": "Toggle voice layer"
        },
        {
          "keys": "2",
          "description": "Toggle item sounds layer"
        },
        {
          "keys": "3",
          "description": "Toggle media layer"
        },
        {
          "keys": "4",
          "description": "Toggle world layer"
        },
        {
          "keys": "E",
          "description": "Select voice effect"
        },
        {
          "keys": "Underscore or Plus",
          "description": "Lower/raise active effect value"
        },
        {
          "keys": "Dash or Equals",
          "description": "Lower/raise master volume"
        },
        {
          "keys": "V",
          "description": "Set mic volume"
        },
        {
          "keys": "Shift+V",
          "description": "Microphone calibration"
        }
      ]
    }
  ]
}
